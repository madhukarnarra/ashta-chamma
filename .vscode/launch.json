{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug Ashta Chamma (Chrome)",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}",
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/src/*"
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Vite Dev Server (Debug Node)",
            "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
            "stopOnEntry": false,
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}